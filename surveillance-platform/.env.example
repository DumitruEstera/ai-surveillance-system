# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# Secret used to sign JWT access tokens (use a long random string).
JWT_SECRET=change-me

# PostgreSQL connection.
DB_HOST=localhost
DB_NAME=facial_recognition
DB_USER=postgres
DB_PASSWORD=change-me

# Password for the default 'admin' user, created on first run.
# If left unset, a random password is generated and printed once at startup.
ADMIN_PASSWORD=change-me
